# Server Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-secret-key-32-chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aidiscovery
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aidiscovery

# Redis & Job Worker Configuration
REDIS_URL=redis://localhost:6379/0

# AI Provider Configuration
# Supported providers: huggingface, openai, ollama, mock
DEFAULT_AI_PROVIDER=mock
HF_TOKEN=
HF_MODEL=meta-llama/Llama-3.2-3B-Instruct
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Optional Connector API Keys (Leave blank to use public/mock modes)
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
YOUTUBE_API_KEY=
APIFY_API_TOKEN=

# Crawler & Security
CRAWLER_MAX_CONCURRENCY=5
CRAWLER_TIMEOUT_SECONDS=10
CRAWLER_USER_AGENT=UniversalAIDiscoveryBot/1.0
SSRF_PROTECTION_ENABLED=true

# CORS & Frontend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
